name: Compilar Vaga Pronta Android
on:
  push:
    paths:
      - 'VagaPronta-Diagnostico-v13-Fontes.zip'
      - '.github/workflows/build-vagapronta.yml'
  workflow_dispatch:
permissions:
  contents: read
jobs:
  apk:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - name: Baixar arquivos do repositorio
        uses: actions/checkout@v4
      - name: Extrair projeto Android
        run: |
          set -euo pipefail
          test -s VagaPronta-Diagnostico-v13-Fontes.zip
          unzip -q VagaPronta-Diagnostico-v13-Fontes.zip
          test -s VagaPronta-Diagnostico-v13/app/build.gradle
      - name: Configurar JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'
      - name: Configurar Gradle 8.9
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'
      - name: Configurar SDK Android oficial
        uses: android-actions/setup-android@v3
      - name: Instalar Build Tools e API Android
        run: sdkmanager 'platforms;android-35' 'build-tools;35.0.0'
      - name: Compilar APK com Android Gradle Plugin
        run: gradle --no-daemon -p VagaPronta-Diagnostico-v13 :app:assembleDebug
      - name: Conferir APK
        shell: bash
        run: |
          set -euo pipefail
          APK=VagaPronta-Diagnostico-v13/app/build/outputs/apk/debug/app-debug.apk
          test -s "$APK"
          "$ANDROID_HOME/build-tools/35.0.0/apksigner" verify --verbose "$APK"
          python3 VagaPronta-Diagnostico-v13/scripts/check_apk.py "$APK"
          sha256sum "$APK"
      - name: Disponibilizar APK como artefato
        uses: actions/upload-artifact@v4
        with:
          name: VagaPronta-Diagnostico-v13-APK
          path: VagaPronta-Diagnostico-v13/app/build/outputs/apk/debug/app-debug.apk
          retention-days: 14
